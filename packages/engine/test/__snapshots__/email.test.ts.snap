<div role="article" aria-roledescription="email" aria-label="Sua conta do agentes.chat vai ser apagada em 6 de novembro de 2026" lang="pt-BR" dir="ltr">
<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fbfbfa">
