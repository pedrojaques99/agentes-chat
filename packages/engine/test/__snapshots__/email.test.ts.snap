exports[`every email, in both languages early_access.pt-BR: snapshot 1`] = `
"<!doctype html>
<html lang="pt-BR" dir="ltr" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
</style>
<style>
@media (prefers-color-scheme:dark){.bg{background:#0f0f0e!important}.card{background:#1c1c1b!important;border-color:#3e3e3d!important}.ink{color:#efefec!important}.tx{color:#d6d6d2!important}.mu{color:#a3a39e!important}.fa{color:#8f8f89!important}.well{background:#0a0a09!important}.wh{border-color:#232322!important}.num{background:#1c1c1b!important;border-color:#3e3e3d!important;color:#a3a39e!important}.btn{background:#efefec!important;color:#0f0f0e!important;border-color:#efefec!important}.btn span{color:#0f0f0e!important}.ln{color:#efefec!important;text-decoration-color:#3e3e3d!important}.avp{background:#0a0a09!important;color:#d6d6d2!important;border-color:#3e3e3d!important}.warn{background:#33260e!important}.warn-t{color:#e0a84a!important}.ln-d{color:#f08a80!important;text-decoration-color:#3e3e3d!important}.ln-m{color:#a3a39e!important;text-decoration-color:#3e3e3d!important}.end-btn{margin-bottom:4px!important}.logo-ink{display:none!important}.logo-bone{display:block!important}}
</style>
<style>
[data-ogsc] .bg{background:#0f0f0e!important}[data-ogsb] .bg{background:#0f0f0e!important}
[data-ogsc] .card{background:#1c1c1b!important;border-color:#3e3e3d!important}[data-ogsb] .card{background:#1c1c1b!important;border-color:#3e3e3d!important}
[data-ogsc] .ink{color:#efefec!important}[data-ogsb] .ink{color:#efefec!important}
[data-ogsc] .tx{color:#d6d6d2!important}[data-ogsb] .tx{color:#d6d6d2!important}
[data-ogsc] .mu{color:#a3a39e!important}[data-ogsb] .mu{color:#a3a39e!important}
[data-ogsc] .fa{color:#8f8f89!important}[data-ogsb] .fa{color:#8f8f89!important}
[data-ogsc] .well{background:#0a0a09!important}[data-ogsb] .well{background:#0a0a09!important}
[data-ogsc] .wh{border-color:#232322!important}[data-ogsb] .wh{border-color:#232322!important}
[data-ogsc] .num{background:#1c1c1b!important;border-color:#3e3e3d!important;color:#a3a39e!important}[data-ogsb] .num{background:#1c1c1b!important;border-color:#3e3e3d!important;color:#a3a39e!important}
[data-ogsc] .btn{background:#efefec!important;color:#0f0f0e!important;border-color:#efefec!important}[data-ogsb] .btn{background:#efefec!important;color:#0f0f0e!important;border-color:#efefec!important}
[data-ogsc] .btn span{color:#0f0f0e!important}[data-ogsb] .btn span{color:#0f0f0e!important}
[data-ogsc] .ln{color:#efefec!important;text-decoration-color:#3e3e3d!important}[data-ogsb] .ln{color:#efefec!important;text-decoration-color:#3e3e3d!important}
[data-ogsc] .avp{background:#0a0a09!important;color:#d6d6d2!important;border-color:#3e3e3d!important}[data-ogsb] .avp{background:#0a0a09!important;color:#d6d6d2!important;border-color:#3e3e3d!important}
[data-ogsc] .warn{background:#33260e!important}[data-ogsb] .warn{background:#33260e!important}
[data-ogsc] .warn-t{color:#e0a84a!important}[data-ogsb] .warn-t{color:#e0a84a!important}
[data-ogsc] .ln-d{color:#f08a80!important;text-decoration-color:#3e3e3d!important}[data-ogsb] .ln-d{color:#f08a80!important;text-decoration-color:#3e3e3d!important}
[data-ogsc] .ln-m{color:#a3a39e!important;text-decoration-color:#3e3e3d!important}[data-ogsb] .ln-m{color:#a3a39e!important;text-decoration-color:#3e3e3d!important}
[data-ogsc] .end-btn{margin-bottom:4px!important}[data-ogsb] .end-btn{margin-bottom:4px!important}
[data-ogsc] .logo-ink{display:none!important}[data-ogsb] .logo-ink{display:none!important}
[data-ogsc] .logo-bone{display:block!important}[data-ogsb] .logo-bone{display:block!important}
